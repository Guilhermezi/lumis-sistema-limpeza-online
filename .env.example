# Modelo de variáveis. Em hospedagens sem suporte a environment, use
# Model/config.local.example.php como base para Model/config.local.php.
# Use development apenas localmente (exibe o link de confirmação para teste).
APP_ENV=production
APP_URL=https://seu-dominio.com/lumis-sistema-limpeza-online
APP_DEMO_MODE=1

DB_HOST=localhost
DB_NAME=lumis
DB_USER=lumis_app
DB_PASSWORD=troque-esta-senha
# Opcional em servidores que conectam pelo socket local:
# DB_SOCKET=/run/mysqld/mysqld.sock

# SMTP externo é necessário em hospedagens que bloqueiam a função mail() do PHP.
MAIL_FROM=no-reply@seu-dominio.com
MAIL_FROM_NAME=Lumis
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=troque-esta-senha
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800
